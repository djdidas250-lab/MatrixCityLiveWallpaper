<!DOCTYPE manifest [<!ENTITY u "http://android.com">]>
<manifest xmlns:android="&u;">
    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />
    <application android:icon="@drawable/ic" android:label="@string/n">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".W" android:enabled="true" android:exported="true" android:label="@string/n" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/w" />
        </service>
    </application>
</manifest>
